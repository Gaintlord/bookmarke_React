# Local development backend. Leave unset to make API calls relative (same
# origin, e.g. when a reverse proxy serves both the app and /api/v1).
VITE_BACKEND_DOMAIN=http://localhost:8081

# Production uses .env.production (Vite loads it for `vite build`) and must
# point at the public API origin, e.g. https://api.bokmarke.world.
